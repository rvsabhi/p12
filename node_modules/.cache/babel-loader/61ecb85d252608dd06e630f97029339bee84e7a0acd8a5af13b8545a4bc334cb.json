em) =>\n        item.id === id\n          ? { ...item, quantity: item.quantity + 1 }\n          : item\n      )\n    );\n  };\n\n  const decreaseQuantity = (id) => {\n    setCart(\n      cart.map((item) =>\n        item.id === id && item.quantity > 1\n          ? { ...item, quantity: item.quantity - 1 }\n          : item\n      )\n    );\n  };\n\n  const total = cart.reduce(\n    (sum, item) => sum + item.price * item.quantity,\n    0\n  );\n\n  return (\n    <div>\n      <h1>Shopping Cart</h1>\n\n      {cart.map((item) => (\n        <div key={item.id}>\n          <h2>{item.name}</h2>\n\n          <p>Price: ₹{item.price}</p>\n\n          <p>Quantity: {item.quantity}</p>\n\n          <button onClick={() => decreaseQuantity(item.id)}>\n            -\n          </button>\n\n          <button onClick={() => increaseQuantity(item.id)}>\n            +\n          </button>\n        </div>\n      ))}\n\n      <h2>Total: ₹{total}</h2>\n    </div>\n  );\n}\n\nexport default App;"],"mappings":"AAAA,MAAO,CAAAA,KAAK,EAAIC,QAAQ,KAAQ,OAAO,CACvC,MAAO,WAAW,CAAC,OAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,yBAEnB,QAAS,CAAAC,GAAGA,CAAA,CAAG,CACb,KAAM,CAACC,IAAI,CAAEC,OAAO,CAAC,CAAGP,QAAQ,CAAC,CAC/B,CACEQ,EAAE,CAAE,CAAC,CACLC,IAAI,CAAE,QAAQ,CACdC,KAAK,CAAE,KAAK,CACZC,QAAQ,CAAE,CACZ,CAAC,CACD,CACEH,EAAE,CAAE,CAAC,CACLC,IAAI,CAAE,YAAY,CAClBC,KAAK,CAAE,IAAI,CACXC,QAAQ,CAAE,CACZ,CAAC,CACD,CACEH,EAAE,CAAE,CAAC,CACLC,IAAI,CAAE,OAAO,CACbC,KAAK,CAAE,GAAG,CACVC,QAAQ,CAAE,CACZ,CAAC,CACF,CAAC,CAEF,KAAM,CAAAC,gBAAgB,CAAIJ,EAAE,EAAK,CAC/BD,OAAO,CACLD,IAAI,CAACO,GAAG,CAAEC,IAAI,EACZA,IAAI,CAACN,EAAE,GAAKA,EAAE,CACV,CAAE,GAAGM,IAAI,CAAEH,QAAQ,CAAEG,IAAI,CAACH,QAAQ,CAAG,CAAE,CAAC,CACxCG,IACN,CACF,CAAC,CACH,CAAC,CAED,KAAM,CAAAC,gBAAgB,CAAIP,EAAE,EAAK,CAC/BD,OAAO,CACLD,IAAI,CAACO,GAAG,CAAEC,IAAI,EACZA,IAAI,CAACN,EAAE,GAAKA,EAAE,EAAIM,IAAI,CAACH,QAAQ,CAAG,CAAC,CAC/B,CAAE,GAAGG,IAAI,CAAEH,QAAQ,CAAEG,IAAI,CAACH,QAAQ,CAAG,CAAE,CAAC,CACxCG,IACN,CACF,CAAC,CACH,CAAC,CAED,KAAM,CAAAE,KAAK,CAAGV,IAAI,CAACW,MAAM,CA